rules_version = '2';

// Season Ranker's database rules (the accounts spec's data model). Browsers may only create and edit
// what these allow; anything that must be trusted (settling bets, balances, tallies) is written by the Admin
// SDK in GitHub Actions, which these rules don't apply to. Tests: tests/rules (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Who's asking
    // -------------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // (its email confirmed: an email-and-password sign-in once its link's been clicked; Google and Facebook vouch
    // for theirs. Asked of what other people see or get: Community entries, votes, friend requests)
    function verified() {
      return signedIn()
        && (request.auth.token.get('email_verified', false) == true
          || request.auth.token.firebase.sign_in_provider != 'password');
    }

    // (a custom claim on the sign-in token, set only with the Admin SDK: set-admin.mjs)
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Friends: both users' friend docs say so (users/{uid}/friends/{otherUid}: { status })
    function friendStatus(uid, other) {
      return get(/databases/$(database)/documents/users/$(uid)/friends/$(other)).data.status;
    }

    function isFriend(owner) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(owner)/friends/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(owner))
        && friendStatus(owner, request.auth.uid) == 'friends'
        && friendStatus(request.auth.uid, owner) == 'friends';
    }

    // Can the reader see the owner's kind of thing ('lists', 'presets', 'openBets', 'betHistory',
    // 'tracker'): the owner always; anyone when it's public; a friend when it's friends
    function canSee(owner, kind) {
      return isOwner(owner) || visibilityOf(owner, kind) == 'public'
        || (visibilityOf(owner, kind) == 'friends' && isFriend(owner));
    }

    // (the owner's setting for a kind; the owner is checked first, so their own reads never need the profile)
    function visibilityOf(owner, kind) {
      return get(/databases/$(database)/documents/users/$(owner)).data.visibility[kind];
    }

    // -------------------------------------------------------------------------
    // The profile's fields
    // -------------------------------------------------------------------------
    function isVisibility(value) {
      return value in ['public', 'friends', 'private'];
    }

    function validVisibility(v) {
      return v is map
        && v.keys().hasOnly(['lists', 'presets', 'openBets', 'betHistory', 'tracker'])
        && v.keys().hasAll(['lists', 'presets', 'openBets', 'betHistory', 'tracker'])
        && isVisibility(v.lists) && isVisibility(v.presets) && isVisibility(v.openBets)
        && isVisibility(v.betHistory) && isVisibility(v.tracker);
    }

    // (a provider's photo or a team logo by its address, or an upload as a small image data URL; 60 KB at most)
    function validPhoto(p) {
      return p == null || (
        p is map
        && p.keys().hasOnly(['kind', 'url'])
        && p.kind in ['provider', 'upload', 'logo']
        && p.url is string
        && p.url.size() > 0
        && p.url.size() <= 61440
        && p.url.matches('^(https://|/[a-z]+/assets/|data:image/(webp|jpeg|png);base64,)[^\\s]*$')
      );
    }

    function validTeam(t) {
      return t == null || (
        t is map
        && t.keys().hasOnly(['sport', 'logo'])
        && t.sport is string && t.sport.size() <= 10
        && t.logo is string && t.logo.size() <= 300
      );
    }

    function validProfile(d) {
      return d.keys().hasAll(['username', 'usernameLower', 'displayName', 'visibility', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['username', 'usernameLower', 'displayName', 'photo', 'favoriteTeam', 'bio', 'visibility', 'createdAt', 'updatedAt'])
        && d.username is string
        && d.username.matches('^[A-Za-z0-9_]{3,20}$')
        && d.usernameLower == d.username.lower()
        && d.displayName is string
        && d.displayName.size() > 0
        && d.displayName.size() <= 40
        && (!('photo' in d) || validPhoto(d.photo))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 200))
        && (!('favoriteTeam' in d) || validTeam(d.favoriteTeam))
        && validVisibility(d.visibility)
        && d.updatedAt == request.time;
    }

    // (the username's claim points at this user once the write is done)
    function claimsName(uid, lower) {
      return getAfter(/databases/$(database)/documents/usernames/$(lower)).data.uid == uid;
    }

    // -------------------------------------------------------------------------
    // users/{uid}: the public profile
    // -------------------------------------------------------------------------
    match /users/{uid} {
      // (one profile at a time, by anyone; never the whole collection listed: no page lists profiles, and a
      // script listing them all would be thousands of reads, each up to a 60 KB photo, billed to the site)
      allow get: if true;

      // (made with its username's claim, in the same transaction)
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && claimsName(uid, request.resource.data.usernameLower);

      // (a new username: claimed in the same transaction, the old claim let go)
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          request.resource.data.usernameLower == resource.data.usernameLower
          || (
            claimsName(uid, request.resource.data.usernameLower)
            && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.usernameLower))
          )
        );

      // (with its username's claim in the same write: a profile dropped alone would hold its name forever)
      allow delete: if isOwner(uid)
        && (resource == null || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.usernameLower)));

      // users/{uid}/private/{doc}: the owner's own settings (their email; later, defaults), no one else's
      match /private/{doc} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['email', 'defaults'])
          && (!('email' in request.resource.data) || request.resource.data.email == null
              || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
          && (!('defaults' in request.resource.data) || request.resource.data.defaults is map);
      }
    }

    // -------------------------------------------------------------------------
    // usernames/{lower}: one claim per name ({ uid }), made with the profile that uses it; let go only by
    // its owner, once their profile no longer uses it (renamed or deleted)
    // -------------------------------------------------------------------------
    match /usernames/{name} {
      // (a name looked up by anyone; listed only a page at a time, as the friends search asks: SEARCH_LIMIT, 12)
      allow get: if true;
      allow list: if request.query.limit <= 12;

      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (
          !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower != name
        );
    }

    // -------------------------------------------------------------------------
    // config/{doc}: site-wide settings anyone can read and only an admin (the token's claim) can change
    // -------------------------------------------------------------------------
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // deskNotes/{id}: the owner's notes on the bettor's picks (a CHECK's mostly; the id the pick's), read by
    // the bettor with the Admin's service account (libs/ranker/scripts/model/notes.mjs): a player's news
    // becomes an injury override for his game's pricing. Admins (the token's claim) only, both ways; a note
    // is { reason, player?, status?, team?, sport?, note?, by, at }, by its writer, at the write's time
    // -------------------------------------------------------------------------
    function validDeskNote(d) {
      return d.keys().hasOnly(['reason', 'player', 'status', 'team', 'sport', 'note', 'by', 'at'])
        && d.keys().hasAll(['reason', 'by', 'at'])
        && d.reason in ['news', 'role', 'weather', 'suspension', 'market-wrong', 'other']
        && (!('player' in d) || d.player == null || (d.player is string && d.player.matches('[0-9]{1,12}')))
        && (!('status' in d) || d.status == null || d.status in ['out', 'questionable', 'active'])
        && (!('team' in d) || d.team == null || (d.team is string && d.team.matches('[0-9]{1,12}')))
        && (!('sport' in d) || d.sport == null || d.sport in ['nfl', 'nba', 'nhl', 'mlb'])
        && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 500))
        && d.by == request.auth.uid
        && d.at == request.time;
    }

    match /deskNotes/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && id.size() <= 200 && validDeskNote(request.resource.data);
    }

    // ---- friends (phase 2) ----
    // users/{uid}/friends/{other}: { status, since } on both sides. A request writes the asker's 'pending-out'
    // and the other's 'pending-in' together; an accept turns both to 'friends'; a decline, cancel or unfriend
    // deletes both. Each side writes its own doc, and the other's only as that mirror, in the same write.
    function friendDoc(uid, other) {
      return /databases/$(database)/documents/users/$(uid)/friends/$(other);
    }

    function validFriend(d, status) {
      return d.keys().hasOnly(['status', 'since'])
        && d.keys().hasAll(['status', 'since'])
        && d.status == status
        && d.since == request.time;
    }

    match /users/{uid}/friends/{other} {
      // (either side of the pair; nobody else)
      allow read: if isOwner(uid) || isOwner(other);

      // (the counterpart is users/{other}/friends/{uid} in every case: new in this write, and saying the other half)
      allow create: if uid != other
        && verified()
        && !exists(friendDoc(other, uid))
        && existsAfter(friendDoc(other, uid))
        && (
          // (asking someone who exists: mine pending-out, theirs pending-in)
          (isOwner(uid) && validFriend(request.resource.data, 'pending-out')
            && getAfter(friendDoc(other, uid)).data.status == 'pending-in'
            && exists(/databases/$(database)/documents/users/$(other)))
          // (the mirror: the asker writes the one asked's pending-in)
          || (isOwner(other) && validFriend(request.resource.data, 'pending-in')
            && getAfter(friendDoc(other, uid)).data.status == 'pending-out'
            && exists(/databases/$(database)/documents/users/$(uid)))
        );

      // (accepting: the one asked turns their pending-in and the asker's pending-out to friends together)
      allow update: if
        (isOwner(uid) && resource.data.status == 'pending-in'
          && validFriend(request.resource.data, 'friends')
          && get(friendDoc(other, uid)).data.status == 'pending-out'
          && getAfter(friendDoc(other, uid)).data.status == 'friends')
        || (isOwner(other) && resource.data.status == 'pending-out'
          && validFriend(request.resource.data, 'friends')
          && get(friendDoc(other, uid)).data.status == 'pending-in'
          && getAfter(friendDoc(other, uid)).data.status == 'friends');

      // (declining, cancelling, unfriending or leaving: either side, both halves gone in the same write)
      allow delete: if (isOwner(uid) || isOwner(other)) && !existsAfter(friendDoc(other, uid));
    }
    // ---- end friends ----

    // ---- tracker (phase 2) ----
    // users/{uid}/pins/{id}: a comparison pinned from the compare view: its title, the compare's link (share.ts:
    // list=…&cmp=…), the sport, its place in the owner's order, the snapshot it was pinned at, and the days it's
    // been looked at since (tracker-helpers.ts keeps the same limits). Seen by whoever the owner's tracker
    // setting lets see it; written by the owner only, the link and sport fixed once pinned.
    function validPin(d) {
      return d.keys().hasAll(['title', 'spec', 'sport', 'order', 'baseline', 'history', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['title', 'spec', 'sport', 'order', 'baseline', 'history', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.spec is string && d.spec.size() <= 4000
        && d.spec.matches('^(list=[A-Za-z0-9_-]+&)?cmp=[^&\\s]+$')
        && d.sport is string && d.sport.matches('^[a-z]{2,8}$')
        && d.order is number
        && d.baseline is map
        && d.baseline.keys().hasAll(['at', 'sides', 'skills', 'rows'])
        && d.baseline.at is number
        && d.baseline.sides is list && d.baseline.sides.size() >= 1 && d.baseline.sides.size() <= 4
        && d.history is list && d.history.size() <= 200
        && d.updatedAt == request.time;
    }

    match /users/{uid}/pins/{pin} {
      allow read: if canSee(uid, 'tracker');

      allow create: if isOwner(uid)
        && validPin(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && validPin(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.spec == resource.data.spec
        && request.resource.data.sport == resource.data.sport;

      allow delete: if isOwner(uid);
    }
    // ---- end tracker ----

    // ---- wallet (phase 2) ----
    // Play money. users/{uid}/wallet/main { balance, start, resets, createdAt, updatedAt, lastBet?, resetAt? }:
    // made once at 500; after that its owner may only (a) take a new bet's stake out, in the same batch as
    // the bet (lastBet names it; the bet's own rule checks the other half), or (b) reload it to 500, one more
    // reset. Never under 0. Settling (winnings in, results on the bets) is the Admin SDK's: settle.mjs. start is
    // what the current run began at: 500, set again by a reload (a wallet made before 2026-10-17 began at 1,000;
    // its balance stands, its start 1,000 till it reloads).
    function walletPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/wallet/main;
    }

    function betPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/bets/$(id);
    }

    function walletKeys(d) {
      return d.keys().hasAll(['balance', 'start', 'resets', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['balance', 'start', 'resets', 'createdAt', 'updatedAt', 'lastBet', 'resetAt']);
    }

    // (a bet's stake out: lastBet names a bet new in this write, the balance down by exactly its stake)
    function placingBet(uid) {
      let next = request.resource.data;
      return next.resets == resource.data.resets
        && next.start == resource.data.start
        && next.get('resetAt', null) == resource.data.get('resetAt', null)
        && next.lastBet is string
        && next.lastBet != resource.data.get('lastBet', '')
        && !exists(betPath(uid, next.lastBet))
        && existsAfter(betPath(uid, next.lastBet))
        && next.balance == resource.data.balance - getAfter(betPath(uid, next.lastBet)).data.stake
        && next.balance >= 0;
    }

    // (a reload: back to 500, the start with it, and one more reset; the bet binding left as it was)
    function reloading() {
      let next = request.resource.data;
      return next.balance == 500
        && next.start == 500
        && next.resets == resource.data.resets + 1
        && next.resetAt == request.time
        && next.get('lastBet', null) == resource.data.get('lastBet', null);
    }

    match /users/{uid}/wallet/{doc} {
      allow read: if doc == 'main' && canSee(uid, 'betHistory');

      allow create: if isOwner(uid) && doc == 'main'
        && walletKeys(request.resource.data)
        && !('lastBet' in request.resource.data)
        && !('resetAt' in request.resource.data)
        && request.resource.data.balance == 500
        && request.resource.data.start == 500
        && request.resource.data.resets == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid) && doc == 'main'
        && walletKeys(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (placingBet(uid) || reloading());

      // (with the account; a wallet made again starts at 500, run 1)
      allow delete: if isOwner(uid);
    }

    // A play bet as placed: open, on a game not started (the settler checks the real start, and the price
    // against the board), a stake in half units, at least a half; a spread or moneyline a side, a total over or under,
    // a prop the bot's (its pick's id in ref, either side) with its player and stat. Its tier the bot's band on it (a
    // CHECK's check: a market the bot questioned, not its pick; only an admin sees the CHECKs, so only an admin's
    // bet carries it, and never as the bot's pick or with a Kelly score)
    function noPropFields(d) {
      return !('propType' in d) && !('athlete' in d) && !('player' in d) && !('statLabel' in d);
    }

    function validPlayMarket(d) {
      return (d.market == 'spread' && d.side in ['home', 'away'] && noPropFields(d)
          && d.line is number && d.line > -100 && d.line < 100)
        || (d.market == 'ml' && d.side in ['home', 'away'] && noPropFields(d) && d.get('line', null) == null)
        || (d.market == 'total' && d.side in ['over', 'under'] && noPropFields(d)
          && d.line is number && d.line > 0 && d.line < 1000)
        || (d.market == 'prop' && d.side in ['over', 'under'] && d.line is number && d.line >= 0 && d.line < 1000
          && d.propType is string && d.propType.size() > 0 && d.propType.size() <= 20
          && d.athlete is string && d.athlete.matches('^[0-9]{1,20}$')
          && d.player is string && d.player.size() <= 60
          && d.statLabel is string && d.statLabel.size() <= 40
          && d.ref is string);
    }

    // (what a bet is on, a straight bet's or a parlay leg's: its game, its market and side, its price, the bot's
    // tag on it)
    // (a UFC bout's matchup its fighters' names, "A @ B" as the MMA board writes them (mma-desk.mjs), each bout
    // with its own start, not the card's; a bout a moneyline or a round total, never a spread or a prop)
    function validPlayPick(d) {
      return d.sport in ['nfl', 'nba', 'nhl', 'mlb', 'mma']
        && d.event is string && d.event.matches('^[0-9]{1,20}$')
        && d.matchup is string
        && ((d.sport != 'mma' && d.matchup.matches('^[A-Z0-9]{2,5} @ [A-Z0-9]{2,5}$'))
          || (d.sport == 'mma' && d.matchup.matches('^[^<>@]{1,48} @ [^<>@]{1,48}$') && d.market in ['ml', 'total']))
        && d.start is timestamp && d.start > request.time && d.start < request.time + duration.value(60, 'd')
        && d.odds is int && ((d.odds >= 100 && d.odds <= 50000) || (d.odds <= -100 && d.odds >= -50000))
        && d.pick is string && d.pick.size() > 0 && d.pick.size() <= 80
        && (!('botPick' in d) || d.botPick is bool)
        && (!('tier' in d) || d.tier in ['lock', 'love', 'like', 'bet', 'pass']
          || (d.tier == 'check' && isAdmin() && d.get('botPick', false) == false && !('kelly' in d)))
        && (!('kelly' in d) || d.kelly is number)
        && (!('ref' in d) || (d.ref is string && d.ref.size() <= 80))
        // (the book whose price it took: a short code, the best US price's (the owner, 2026-10-20); a parlay leg's
        // unchecked, the expression limit's)
        && (!('book' in d) || (d.book is string && d.book.size() <= 8))
        && validPlayMarket(d)
        && validPreview(d);
    }

    // (a preview prop: a DraftKings line off ESPN the bot hadn't priced (preview-props.ts), no price posted, so
    // only at the assumed -110, never the bot's pick, no band, no Kelly score; the settler checks its line against
    // the lines ESPN showed, settle-lib.mjs previewLineCheck)
    function validPreview(d) {
      return !('preview' in d)
        || (d.preview == true && d.market == 'prop' && d.odds == -110
          && d.get('botPick', false) == false && !('tier' in d) && !('kelly' in d));
    }

    // (a bet's stake, its run, and placed open now: a straight bet's and a parlay's alike)
    function validPlayStake(d) {
      return d.stake is number && d.stake >= 0.5 && math.floor(d.stake * 2) == d.stake * 2
        && d.run is int && d.run >= 0
        && d.placedAt == request.time
        && d.status == 'open';
    }

    function validPlayBet(d) {
      return d.keys().hasAll(['sport', 'event', 'matchup', 'start', 'market', 'side', 'odds', 'stake', 'pick', 'run', 'placedAt', 'status'])
        && d.keys().hasOnly(['sport', 'event', 'matchup', 'start', 'market', 'side', 'line', 'odds', 'stake', 'pick', 'botPick', 'tier', 'kelly', 'ref', 'propType', 'athlete', 'player', 'statLabel', 'preview', 'book', 'run', 'placedAt', 'status'])
        && validPlayPick(d)
        && validPlayStake(d);
    }

    // A parlay: one bet of 2 to 10 legs (kind 'parlay'), each leg what a straight bet is on, on a game of its own:
    // games names each leg's "sport_event" in order, no game twice (no same-game parlays: their prices carry the
    // book's correlation adjustments). A leg carries a straight bet's fields and nothing else (no stake, and no
    // result: the settler writes each leg's); its start no earlier than the parlay's (its first leg's, when the
    // settler first looks). Its odds only what it was placed at: the settler pays from the legs' own prices, never
    // a figure of the browser's. The rules evaluate 1,000 expressions a write at most, and ten legs checked as a
    // straight bet is would take several times that: a leg's own market, side, line and price are the settler's
    // to check (settle-lib.mjs legProblem and the price check: a leg that isn't a bet on the board is void and
    // drops out; a preview leg's held to a prop at -110 there too, legProblem), and only an admin's straight bet can be
    // a CHECK's (a parlay's leg tagged one is just a tag).
    // Its event checked here all the same: the settler reads ESPN and its own docs by it, so a game's id only, with
    // no leading zero (ESPN takes a padded id as the game's own, which would put two legs on one game past the
    // games check); and its start within the 60 days a straight bet's is (a leg never due would hold the stake).
    // A leg's fields and that latest start worked out once (validParlay) and passed down: written out in each leg's
    // check they'd count ten times toward the limit, and ten prop legs wouldn't fit
    function parlayLeg(x, game, start, fields, end) {
      return x.keys().hasOnly(fields)
        && x.event.matches('^[1-9][0-9]{0,19}$')
        && game == x.sport + '_' + x.event
        && x.start >= start && x.start < end;
    }

    // (each leg in turn, only as many as it has: parlayLegs0 the first on)
    function parlayLegs9(d, fields, end) {
      return d.legs.size() <= 9 || (parlayLeg(d.legs[9], d.games[9], d.start, fields, end));
    }

    function parlayLegs8(d, fields, end) {
      return d.legs.size() <= 8 || (parlayLeg(d.legs[8], d.games[8], d.start, fields, end) && parlayLegs9(d, fields, end));
    }

    function parlayLegs7(d, fields, end) {
      return d.legs.size() <= 7 || (parlayLeg(d.legs[7], d.games[7], d.start, fields, end) && parlayLegs8(d, fields, end));
    }

    function parlayLegs6(d, fields, end) {
      return d.legs.size() <= 6 || (parlayLeg(d.legs[6], d.games[6], d.start, fields, end) && parlayLegs7(d, fields, end));
    }

    function parlayLegs5(d, fields, end) {
      return d.legs.size() <= 5 || (parlayLeg(d.legs[5], d.games[5], d.start, fields, end) && parlayLegs6(d, fields, end));
    }

    function parlayLegs4(d, fields, end) {
      return d.legs.size() <= 4 || (parlayLeg(d.legs[4], d.games[4], d.start, fields, end) && parlayLegs5(d, fields, end));
    }

    function parlayLegs3(d, fields, end) {
      return d.legs.size() <= 3 || (parlayLeg(d.legs[3], d.games[3], d.start, fields, end) && parlayLegs4(d, fields, end));
    }

    function parlayLegs2(d, fields, end) {
      return d.legs.size() <= 2 || (parlayLeg(d.legs[2], d.games[2], d.start, fields, end) && parlayLegs3(d, fields, end));
    }

    function parlayLegs1(d, fields, end) {
      return d.legs.size() <= 1 || (parlayLeg(d.legs[1], d.games[1], d.start, fields, end) && parlayLegs2(d, fields, end));
    }

    function parlayLegs0(d, fields, end) {
      return d.legs.size() <= 0 || (parlayLeg(d.legs[0], d.games[0], d.start, fields, end) && parlayLegs1(d, fields, end));
    }

    function validParlay(d) {
      return d.keys().hasAll(['kind', 'legs', 'games', 'start', 'odds', 'stake', 'pick', 'run', 'placedAt', 'status'])
        && d.keys().hasOnly(['kind', 'legs', 'games', 'start', 'odds', 'stake', 'pick', 'run', 'placedAt', 'status'])
        && d.kind == 'parlay'
        && d.legs.size() >= 2 && d.legs.size() <= 10
        && d.games.size() == d.legs.size() && d.games.toSet().size() == d.games.size()
        && d.start is timestamp && d.start > request.time
        && d.odds is int && (d.odds >= 100 || d.odds <= -100)
        && d.pick is string && d.pick.size() <= 80
        && validPlayStake(d)
        && parlayLegs0(d, ['sport', 'event', 'matchup', 'start', 'market', 'side', 'line', 'odds', 'pick', 'botPick', 'tier', 'kelly', 'ref', 'propType', 'athlete', 'player', 'statLabel', 'preview', 'book'], request.time + duration.value(60, 'd'));
    }

    match /users/{uid}/bets/{bet} {
      // (the owner; others by the owner's settings: open bets and the settled history apart)
      allow read: if isOwner(uid)
        || (resource.data.status == 'open' && canSee(uid, 'openBets'))
        || (resource.data.status != 'open' && canSee(uid, 'betHistory'));

      // (with its stake out of the wallet in the same write, in the wallet's current run)
      // (never with bot: the bot's call on the bet, You vs the Bot's, is the settler's alone; the shapes' hasOnly
      // leaves it out too)
      allow create: if isOwner(uid)
        && !('bot' in request.resource.data)
        && ('kind' in request.resource.data ? validParlay(request.resource.data) : validPlayBet(request.resource.data))
        && exists(walletPath(uid))
        && request.resource.data.run == get(walletPath(uid)).data.resets
        && getAfter(walletPath(uid)).data.get('lastBet', '') == bet
        && getAfter(walletPath(uid)).data.balance == get(walletPath(uid)).data.balance - request.resource.data.stake;

      // (settled only by the Admin SDK; a settled one deleted by its owner: Clear history, or the account going.
      // An open bet stays until it's settled, so a losing one can't be dropped before the settler counts it; a
      // deleted account's open bets are removed by the settler; its bot, the bot's call on it, the settler's too)
      allow update: if false;
      allow delete: if isOwner(uid) && resource.data.status != 'open';
    }

    // tallies/{uid}: the settler's record of a user's settled bets, lifetime, by day and each day's by sport (kept
    // through a cleared history: the leaderboards' source, and the wallet's record and chart). Admin only
    match /tallies/{uid} {
      allow read: if canSee(uid, 'betHistory');
      allow write: if false;
    }

    // leaderboards/{week|season|all}: public players' records, by profit (Admin only)
    match /leaderboards/{period} {
      allow read: if true;
      allow write: if false;
    }

    // lines/{sport_event}: the settler's snapshots of a game's lines, to check bets' prices against (Admin only)
    match /lines/{id} {
      allow read, write: if false;
    }
    // propLines/{sport_event}: the settler's look at a game's preview prop lines (each player's stat's lowest and
    // highest main line seen), to check preview bets' lines against (Admin only)
    match /propLines/{id} {
      allow read, write: if false;
    }
    // ---- end wallet ----

    // ---- lists (phase 2) ----
    // users/{uid}/presets/{id}: a tab's sliders and switched-off stats and groups under a name (lists-helpers.ts
    // keeps the same limits). Seen by whoever the owner's presets setting lets see them; written by the owner.
    function validPreset(d) {
      return d.keys().hasAll(['sport', 'tab', 'name', 'settings', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['sport', 'tab', 'name', 'settings', 'createdAt', 'updatedAt'])
        && d.sport is string && d.sport.matches('^[a-z]{2,8}$')
        && d.tab is string && d.tab.matches('^[A-Za-z0-9]{1,12}$')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.settings is map
        && d.settings.keys().hasOnly(['weights', 'hidden', 'groups'])
        && d.settings.weights is map && d.settings.weights.size() <= 120
        && d.settings.hidden is list && d.settings.hidden.size() <= 120
        && d.settings.groups is list && d.settings.groups.size() <= 12
        && d.updatedAt == request.time;
    }

    // (no visibility of its own: the owner's presets setting is the only one the rules read)
    match /users/{uid}/presets/{preset} {
      allow read: if canSee(uid, 'presets');
      allow create: if isOwner(uid) && validPreset(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validPreset(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    // users/{uid}/lists/{id}: a saved list, frozen (its order, at most 50 players, and the numbers in the columns
    // that were showing, at most 60). Each list says who sees it (its own visibility, which starts from the
    // owner's lists setting): its owner always, anyone when public, a friend when friends. The community mark
    // is the owner's to set and clear.
    function validList(d) {
      return d.keys().hasAll(['sport', 'tab', 'season', 'part', 'title', 'ids', 'snapshot', 'columns', 'visibility', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['sport', 'tab', 'season', 'part', 'basis', 'title', 'note', 'ids', 'snapshot', 'columns', 'labels', 'formats', 'lower', 'visibility', 'community', 'createdAt', 'updatedAt'])
        && d.sport is string && d.sport.matches('^[a-z]{2,8}$')
        && d.tab is string && d.tab.matches('^[A-Za-z0-9]{1,12}$')
        && d.season is int && d.season >= 1900 && d.season <= 2100
        && d.part in ['regular', 'post', 'all']
        && (!('basis' in d) || (d.basis is string && d.basis.size() <= 12))
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && (!('note' in d) || (d.note is string && d.note.size() <= 500))
        && d.ids is list && d.ids.size() <= 50
        && d.snapshot is map && d.snapshot.size() <= 50
        && d.columns is list && d.columns.size() <= 60
        && (!('labels' in d) || (d.labels is list && d.labels.size() <= 60))
        && (!('formats' in d) || (d.formats is list && d.formats.size() <= 60))
        && (!('lower' in d) || (d.lower is list && d.lower.size() <= 60))
        && isVisibility(d.visibility)
        && (!('community' in d) || d.community == null
          || (d.community is map && d.community.keys().hasOnly(['submitted', 'key'])
            && d.community.submitted == true && d.community.key is string && d.community.key.size() <= 40))
        && d.updatedAt == request.time;
    }

    match /users/{uid}/lists/{list} {
      allow read: if isOwner(uid)
        || resource.data.visibility == 'public'
        || (resource.data.visibility == 'friends' && isFriend(uid));
      allow create: if isOwner(uid) && validList(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validList(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    // community/{key}: a board (sport_tab_season). Its tally (the consensus and the votes added up) is the Admin
    // SDK's to write; the browsers work it out from the entries for now.
    match /community/{key} {
      allow read: if true;
      allow write: if isAdmin();

      // community/{key}/entries/{uid}: one submitted list per user per board, anyone may read; only its owner
      // writes it (submitting again replaces it) or takes it down; it must be one of the owner's own lists
      match /entries/{owner} {
        allow read: if true;
        allow create, update: if isOwner(owner)
          && verified()
          && key.matches('^[a-z]{2,8}_[A-Za-z0-9]{1,12}_[0-9]{4}$')
          && request.resource.data.keys().hasAll(['listId', 'title', 'ownerName', 'ids', 'submittedAt'])
          && request.resource.data.keys().hasOnly(['listId', 'title', 'ownerName', 'ids', 'names', 'logos', 'submittedAt'])
          && request.resource.data.listId is string && request.resource.data.listId.size() <= 40
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
          && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 40
          && request.resource.data.ids is list && request.resource.data.ids.size() > 0 && request.resource.data.ids.size() <= 50
          && (!('names' in request.resource.data) || (request.resource.data.names is list && request.resource.data.names.size() == request.resource.data.ids.size()))
          && (!('logos' in request.resource.data) || (request.resource.data.logos is list && request.resource.data.logos.size() == request.resource.data.ids.size()))
          && request.resource.data.submittedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(owner)/lists/$(request.resource.data.listId));
        allow delete: if isOwner(owner);

        // .../votes/{voter}: { value: 1 or -1, voter, at }: one per person per entry, written by the voter on
        // their own doc, never on their own entry. `at` is the submission's time (the entry's submittedAt) and
        // only a vote for the current submission counts, so a submission made again starts its votes over. The
        // voter takes theirs back; the entry's owner may clear only stale ones (the entry gone or submitted again
        // in the same write or before), never pick off the down votes on the entry as it stands
        function entryPath() {
          return /databases/$(database)/documents/community/$(key)/entries/$(owner);
        }

        match /votes/{voter} {
          allow read: if true;
          allow create, update: if isOwner(voter)
            && verified()
            && voter != owner
            && exists(entryPath())
            && request.resource.data.keys().hasOnly(['value', 'voter', 'at'])
            && request.resource.data.keys().hasAll(['value', 'voter', 'at'])
            && request.resource.data.voter == voter
            && request.resource.data.value in [1, -1]
            && request.resource.data.at == get(entryPath()).data.submittedAt;
          allow delete: if isOwner(voter)
            || (isOwner(owner)
              && (!existsAfter(entryPath()) || getAfter(entryPath()).data.submittedAt != resource.data.get('at', null)));
        }
      }
    }

    // (a user's own votes, wherever they are: found to delete with the account)
    match /{path=**}/votes/{voter} {
      allow read: if signedIn() && resource.data.voter == request.auth.uid;
    }
    // ---- end lists ----
  }
}
